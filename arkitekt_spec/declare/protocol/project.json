{
    "schema": "http://jhnnsrs-lab/rekuest/schema",
    "documents": "graphql/**/**.graphql",
    "extensions": {
        "turms": {
            "domain": null,
            "out_dir": "rekuest/protocol",
            "dump_configuration": true,
            "configuration_name": "project.json",
            "dump_schema": false,
            "schema_name": "schema.graphql",
            "generated_name": "schema.py",
            "documents": "graphql/**/**.graphql",
            "verbose": false,
            "exit_on_error": true,
            "allow_introspection": true,
            "object_bases": [
                "pydantic.BaseModel"
            ],
            "interface_bases": null,
            "always_resolve_interfaces": true,
            "exclude_typenames": true,
            "scalar_definitions": {
                "uuid": "str",
                "Callback": "str",
                "Any": "typing.Any",
                "AnyInput": "typing.Any",
                "JSONSerializable": "rekuest.scalars.JSONSerializable",
                "UISchema": "rekuest.scalars.UISchema",
                "AnyDefault": "typing.Any",
                "Args": "rekuest.scalars.Args",
                "ValueMap": "rekuest.scalars.ValueMap",
                "MediaLike": "rekuest.scalars.MediaLike",
                "ID": "rath.scalars.ID",
                "ActionHash": "rekuest.scalars.ActionHash",
                "Arg": "typing.Any",
                "Identifier": "rekuest.scalars.Identifier",
                "SearchQuery": "rekuest.scalars.SearchQuery"
            },
            "coercible_scalars": {},
            "coercible_inputs": {},
            "graphql_default_class": null,
            "deprecated_class": null,
            "document_field_metadata": true,
            "unset_type_class": null,
            "unset_instance": null,
            "freeze": {
                "enabled": true,
                "types": [
                    "input",
                    "fragment",
                    "object"
                ],
                "exclude": null,
                "include": null,
                "convert_list_to_tuple": true
            },
            "create_catchall": true,
            "options": {
                "enabled": true,
                "extra": "forbid",
                "populate_by_name": true,
                "from_attributes": null,
                "use_enum_values": true,
                "validate_assignment": null,
                "alias_mode": "split",
                "types": [
                    "input"
                ],
                "exclude": null,
                "include": null
            },
            "skip_forwards": false,
            "min_python_version": "3.10",
            "type_annotation_style": "auto",
            "external_modules": [
                {
                    "module": "arkitekt_spec.actions",
                    "kinds": [
                        "enum",
                        "input"
                    ],
                    "names": {},
                    "include": [
                        "ActionArgumentInput",
                        "ActionDemandInput",
                        "ActionDependencyInput",
                        "ActionKind",
                        "AgentDependencyInput",
                        "AgentProbeInput",
                        "ArgPortInput",
                        "AssignWidgetInput",
                        "BlokImplementationInput",
                        "ChoiceAssignWidgetInput",
                        "ChoiceInput",
                        "ChoiceReturnWidgetInput",
                        "ComponentNodeInput",
                        "ComponentPropInput",
                        "CustomAssignWidgetInput",
                        "CustomReturnWidgetInput",
                        "DefinitionInput",
                        "DescriptorInput",
                        "DescriptorOperator",
                        "DynamicValueInput",
                        "EffectInput",
                        "EffectKind",
                        "ImplementAgentInput",
                        "ImplementationInput",
                        "LockDefinitionInput",
                        "LockImplementationInput",
                        "OptimisticInput",
                        "OptionKey",
                        "PortGroupInput",
                        "PortKind",
                        "PortMatchInput",
                        "ProvidesInput",
                        "ProxyAssignWidgetInput",
                        "RequiresInput",
                        "ReturnPortInput",
                        "ReturnWidgetInput",
                        "SearchAssignWidgetInput",
                        "SliderAssignWidgetInput",
                        "StateAccessorInput",
                        "StateChoiceAssignWidgetInput",
                        "StateDefinitionInput",
                        "StateDemandInput",
                        "StateDependencyInput",
                        "StateImplementationInput",
                        "StringAssignWidgetInput",
                        "TestTargetInput",
                        "TrackInput",
                        "UtilCallInput",
                        "ValidatorInput",
                        "WindowFunction",
                        "WindowInput"
                    ],
                    "from_project": null
                }
            ],
            "additional_bases": {
                "CreateBlokInput": [
                    "rekuest.traits.blok.CreateBlokInputTrait"
                ]
            },
            "additional_config": {},
            "force_plugin_order": true,
            "omitted_document_rules": [],
            "parsers": [],
            "plugins": [
                {
                    "type": "turms.plugins.enums.EnumsPlugin"
                },
                {
                    "type": "turms.plugins.inputs.InputsPlugin"
                }
            ],
            "processors": [
                {
                    "type": "turms.processors.disclaimer.DisclaimerProcessor"
                }
            ],
            "stylers": [
                {
                    "type": "turms.stylers.default.DefaultStyler"
                },
                {
                    "type": "turms.stylers.appender.AppenderStyler",
                    "append_fragment": ""
                }
            ]
        }
    }
}
